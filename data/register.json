    { "id": "apartment-reservations","name": "Apartment reservations","contract": "unit-reservation v1",     "security_level": "secret",       "every_min": 30,
      "path": { "source": "SRC-CRM",  "integration": "INT-01", "dynamics": "D365-FIN", "apps": "APP-CUS",  "analytics": "ANA-01" } }
