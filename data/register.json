    { "id": "SRC-CRM",  "name": "Sales CRM",              "stage": "source",      "owner": "Henna Järvinen", "team": "Residential sales",    "clearance": "secret" },
    { "id": "INT-01",   "name": "Integration hub",        "stage": "integration", "owner": "Noora Ahonen",   "team": "Integration team",     "clearance": "secret" },
    { "id": "INT-02",   "name": "IoT hub",                "stage": "integration", "owner": "Noora Ahonen",   "team": "Integration team",     "clearance": "internal" },
    { "id": "D365-FIN", "name": "Dynamics 365 Finance",   "stage": "dynamics",    "owner": "Ville Koskinen", "team": "ERP team",             "clearance": "confidential" },
    { "id": "APP-PRC",  "name": "Procurement app",        "stage": "apps",        "owner": "Joonas Mäkelä",  "team": "Procurement",          "clearance": "confidential" },
    { "id": "APP-PRJ",  "name": "Project app",            "stage": "apps",        "owner": "Aino Lehtinen",  "team": "Project controlling",  "clearance": "confidential" },
    { "id": "APP-SITE", "name": "Site app",               "stage": "apps",        "owner": "Elina Rantanen", "team": "Site operations",      "clearance": "confidential" },
    { "id": "APP-CUS",  "name": "Customer portal",        "stage": "apps",        "owner": "Olli Peltonen",  "team": "Residential sales",    "clearance": "confidential" },
    { "id": "ANA-01",   "name": "Analytics platform",     "stage": "analytics",   "owner": "Antti Lindqvist","team": "Data platform",        "clearance": "confidential" }
